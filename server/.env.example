# Backend Environment Variables
# Copy this to .env and fill in values

# SendGrid Email Service
SENDGRID_API_KEY=your_sendgrid_api_key_here
COMPANY_EMAIL=your-email@gmail.com
SENDER_EMAIL=your-email@gmail.com

# PostgreSQL Database
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=itech_store
# For production, use cloud database:
# DB_HOST=your-database.region.rds.amazonaws.com (AWS RDS)
# or
# DB_HOST=your-database.railway.app (Railway)

# JWT Secret - Change this to random string!
JWT_SECRET=your_super_secret_jwt_key_change_this

# Server Port
PORT=4000

# Node Environment
NODE_ENV=development
# NODE_ENV=production (for production)

# Admin Configuration
ADMIN_PASSWORD=itechadmin

# Paystack Payment Gateway
# Get these from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_CALLBACK_URL=https://yourdomain.com/#/payment-success
PAYSTACK_WEBHOOK_URL=https://yourdomain.com/api/payments/webhook

# OpenAI Chatbot
OPENAI_API_KEY=your_openai_api_key_here
